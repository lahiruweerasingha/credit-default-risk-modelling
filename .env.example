# Copy to .env to override docker-compose defaults. No secrets are needed for this project:
# the Freddie Mac files are downloaded manually after registering on their site.
SPARK_WORKER_CORES=6
SPARK_WORKER_MEMORY=4g
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=3g

# One image for the Spark master, the Spark worker and the pipeline driver, so every JVM and
# Python process in the cluster runs exactly the same versions.
FROM python:3.11-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /bin/uv

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH \
    PYSPARK_PYTHON=/opt/venv/bin/python \
    PYSPARK_DRIVER_PYTHON=/opt/venv/bin/python \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --extra spark --group dev --no-install-project
COPY src ./src
RUN uv sync --frozen --extra spark --group dev
COPY configs ./configs
COPY tests ./tests

# pip-installed PySpark ships the Spark launch scripts; expose them as SPARK_HOME.
RUN ln -s "$(python -c 'import pyspark, os; print(os.path.dirname(pyspark.__file__))')" /opt/spark
ENV SPARK_HOME=/opt/spark PATH=/opt/spark/bin:/opt/spark/sbin:/opt/venv/bin:$PATH

CMD ["python", "-m", "creditrisk.cli", "--help"]
